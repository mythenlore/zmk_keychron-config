/*
 * Keychron B1 Pro matrix probe keymap
 *
 * Every electrical scan coordinate emits a token of the form:
 *   RrCcc<space>
 *
 * Example:
 *   R0C00 R3C14 R7C05
 *
 * The final five entries (R8C00..R8C04) are the direct GPIO inputs
 * in Keychron's composite scanner.
 *
 * IMPORTANT: This is diagnostic firmware, not a usable typing layout.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

#include <dt-bindings/zmk/outputs.h>

/ {
    /*
     * Keychron's behavior_outputs node is declared /omit-if-no-ref/.
     * Several Keychron-specific source files call helper functions that are
     * implemented by behavior_outputs.c, so keep a DT reference to &out even
     * though the diagnostic layer itself does not use output switching.
     */
    ZMK_MACRO(probe_keep_outputs, bindings = <&out OUT_BLE>;)

    ZMK_MACRO(probe_r0c00, bindings = <&kp R &kp N0 &kp C &kp N0 &kp N0 &kp SPACE>;)
    ZMK_MACRO(probe_r0c01, bindings = <&kp R &kp N0 &kp C &kp N0 &kp N1 &kp SPACE>;)
    ZMK_MACRO(probe_r0c02, bindings = <&kp R &kp N0 &kp C &kp N0 &kp N2 &kp SPACE>;)
    ZMK_MACRO(probe_r0c03, bindings = <&kp R &kp N0 &kp C &kp N0 &kp N3 &kp SPACE>;)
    ZMK_MACRO(probe_r0c04, bindings = <&kp R &kp N0 &kp C &kp N0 &kp N4 &kp SPACE>;)
