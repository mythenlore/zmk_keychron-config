    ZMK_MACRO(probe_r0c06, bindings = <&kp R &kp N0 &kp C &kp N0 &kp N6 &kp SPACE>;)
    ZMK_MACRO(probe_r0c07, bindings = <&kp R &kp N0 &kp C &kp N0 &kp N7 &kp SPACE>;)
    ZMK_MACRO(probe_r0c08, bindings = <&kp R &kp N0 &kp C &kp N0 &kp N8 &kp SPACE>;)
    ZMK_MACRO(probe_r0c09, bindings = <&kp R &kp N0 &kp C &kp N0 &kp N9 &kp SPACE>;)
    ZMK_MACRO(probe_r0c10, bindings = <&kp R &kp N0 &kp C &kp N1 &kp N0 &kp SPACE>;)
    ZMK_MACRO(probe_r0c11, bindings = <&kp R &kp N0 &kp C &kp N1 &kp N1 &kp SPACE>;)
    ZMK_MACRO(probe_r0c12, bindings = <&kp R &kp N0 &kp C &kp N1 &kp N2 &kp SPACE>;)
    ZMK_MACRO(probe_r0c13, bindings = <&kp R &kp N0 &kp C &kp N1 &kp N3 &kp SPACE>;)
    ZMK_MACRO(probe_r0c14, bindings = <&kp R &kp N0 &kp C &kp N1 &kp N4 &kp SPACE>;)
    ZMK_MACRO(probe_r0c15, bindings = <&kp R &kp N0 &kp C &kp N1 &kp N5 &kp SPACE>;)
    ZMK_MACRO(probe_r0c16, bindings = <&kp R &kp N0 &kp C &kp N1 &kp N6 &kp SPACE>;)
