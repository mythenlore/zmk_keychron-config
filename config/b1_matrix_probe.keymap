    ZMK_MACRO(probe_r5c11, bindings = <&kp R &kp N5 &kp C &kp N1 &kp N1 &kp SPACE>;)
    ZMK_MACRO(probe_r5c12, bindings = <&kp R &kp N5 &kp C &kp N1 &kp N2 &kp SPACE>;)
    ZMK_MACRO(probe_r5c13, bindings = <&kp R &kp N5 &kp C &kp N1 &kp N3 &kp SPACE>;)
