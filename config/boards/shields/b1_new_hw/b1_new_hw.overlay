/*
 * Keychron B1 Pro newer-hardware matrix override.
 *
 * Verified on B1P-K1 hardware by a complete 77-key physical matrix sweep.
 * Loaded after Keychron's normal keychron_b1_us shield:
 *
 *   SHIELD="keychron_b1_us b1_new_hw"
 *
 * Logical key order remains identical to Keychron's stock B1 US keymap:
 * 77 keyboard positions followed by the 5 direct-input positions.
 */

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/zmk/matrix_transform.h>

&kscan0 {
    diode-direction = "row2col";

    row-gpios =
        <&gpio1 0 GPIO_ACTIVE_HIGH>,
        <&gpio1 1 GPIO_ACTIVE_HIGH>,
        <&gpio1 2 GPIO_ACTIVE_HIGH>,
        <&gpio1 4 GPIO_ACTIVE_HIGH>,
        <&gpio1 6 GPIO_ACTIVE_HIGH>,
        <&gpio1 7 GPIO_ACTIVE_HIGH>,
        <&gpio1 10 GPIO_ACTIVE_HIGH>,
        <&gpio1 12 GPIO_ACTIVE_HIGH>;

    col-gpios =
        <&gpio0 0 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
        <&gpio0 1 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
        <&gpio0 26 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
        <&gpio0 27 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
        <&gpio0 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
        <&gpio0 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
        <&gpio0 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
        <&gpio0 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
        <&gpio0 8 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
        <&gpio0 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
        <&gpio0 12 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
        <&gpio0 13 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
        <&gpio0 14 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
        <&gpio0 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
        <&gpio0 16 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
        <&gpio0 17 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
        <&gpio0 18 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
        <&gpio0 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
};

&default_transform {
    columns = <18>;
    rows = <9>;
    map = <
        RC(7,5) RC(1,2) RC(3,4) RC(1,14) RC(1,4) RC(2,2) RC(4,2) RC(2,5) RC(2,6) RC(2,7) RC(2,10) RC(2,8) RC(3,7) RC(5,8)
        RC(0,17) RC(1,0) RC(1,15) RC(1,1) RC(3,6) RC(1,12) RC(1,13) RC(5,5) RC(5,6) RC(5,7) RC(5,10) RC(1,6) RC(1,7) RC(1,8)
        RC(0,5) RC(0,10) RC(0,8) RC(0,9) RC(0,13) RC(0,14) RC(3,5) RC(3,1) RC(1,3) RC(2,4) RC(1,11) RC(4,6) RC(4,7) RC(4,10)
        RC(5,17) RC(0,4) RC(0,6) RC(0,7) RC(0,2) RC(1,17) RC(6,8) RC(1,10) RC(3,2) RC(1,9) RC(6,5) RC(6,7) RC(2,1)
        RC(0,16) RC(0,0) RC(0,15) RC(0,1) RC(0,12) RC(0,11) RC(7,6) RC(7,11) RC(7,10) RC(7,8) RC(7,9) RC(5,15)
        RC(1,5) RC(3,10) RC(6,17) RC(0,3) RC(4,0) RC(2,9) RC(3,17) RC(2,17) RC(4,17) RC(7,17)
        RC(8,0) RC(8,1) RC(8,2) RC(8,3) RC(8,4)
    >;
};
